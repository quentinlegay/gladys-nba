{
  "manifest_version": 1,
  "type": "calendar",
  "name": "NBA",
  "description": {
    "en": "NBA games in your Gladys calendar, filtered on tip-off times that suit you.",
    "fr": "Les matchs NBA dans votre calendrier Gladys, filtrés sur les horaires qui vous conviennent."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/quentinlegay/gladys-nba:1.0.0",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/quentinlegay/gladys-nba/main/cover.png",
  "categories": ["leisure", "services"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "about",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement"
      },
      "description": {
        "en": "The NBA schedule comes from the public ESPN API: no account, no key. Every user enables the integration in the \"My calendars\" block and chooses their teams and tip-off times there: they get their own \"NBA\" calendar.",
        "fr": "Le calendrier NBA vient de l'API publique d'ESPN : pas de compte, pas de clé. Chaque utilisateur active l'intégration dans le bloc « Mes calendriers » et y choisit ses équipes et ses horaires : il obtient son propre calendrier « NBA »."
      },
      "links": [
        {
          "url": "https://github.com/quentinlegay/gladys-nba/blob/main/docs/en.md",
          "label": {
            "en": "Documentation",
            "fr": "Documentation (anglais)"
          }
        },
        {
          "url": "https://github.com/quentinlegay/gladys-nba/blob/main/docs/fr.md",
          "label": {
            "en": "Documentation (French)",
            "fr": "Documentation"
          }
        }
      ]
    },
    {
      "key": "sync_interval",
      "type": "number",
      "label": {
        "en": "Sync interval (minutes)",
        "fr": "Intervalle de synchronisation (minutes)"
      },
      "description": {
        "en": "How often the schedule is read on ESPN and the calendars updated (15 to 1440).",
        "fr": "Fréquence de lecture du calendrier sur ESPN et de mise à jour des calendriers (15 à 1440)."
      },
      "placeholder": {
        "en": "60",
        "fr": "60"
      },
      "default": 60,
      "min": 15,
      "max": 1440
    }
  ],
  "account_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your NBA calendar",
        "fr": "Votre calendrier NBA"
      },
      "description": {
        "en": "Pick the teams you follow (none: every game) and the tip-off window: for instance \"until 00:00\" in Europe/Paris keeps only the games you can watch in the evening in France. Enable the integration: an \"NBA\" calendar appears in your Gladys calendars, private until you share it.",
        "fr": "Choisissez les équipes que vous suivez (aucune : tous les matchs) et la plage d'horaires : par exemple « jusqu'à 00:00 » en Europe/Paris ne garde que les matchs visibles en soirée en France. Activez l'intégration : un calendrier « NBA » apparaît dans vos calendriers Gladys, privé tant que vous ne le partagez pas."
      }
    },
    {
      "key": "teams",
      "type": "multi_select",
      "label": {
        "en": "Teams",
        "fr": "Équipes"
      },
      "description": {
        "en": "The games of these teams go into your calendar. Leave empty to get every NBA game.",
        "fr": "Les matchs de ces équipes vont dans votre calendrier. Laissez vide pour avoir tous les matchs NBA."
      },
      "options": [
