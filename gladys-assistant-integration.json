    {
      "key": "timezone",
      "type": "string",
      "label": {
        "en": "Time zone",
        "fr": "Fuseau horaire"
      },
      "description": {
        "en": "The tip-off window below is read in this time zone (IANA name, e.g. Europe/Paris, Europe/Brussels, America/Montreal).",
        "fr": "La plage horaire ci-dessous est lue dans ce fuseau (nom IANA, ex. Europe/Paris, Europe/Brussels, America/Montreal)."
      },
      "placeholder": {
        "en": "Europe/Paris",
        "fr": "Europe/Paris"
      },
      "default": "Europe/Paris"
    },
    {
      "key": "schedule",
      "type": "section",
      "label": {
        "en": "Tip-off times",
        "fr": "Horaires de début de match"
      },
      "description": {
        "en": "Only the games starting between these two times (HH:MM, both included) are added. Leave the earliest time empty for \"from 06:00\", the latest empty for \"until 05:59\". Both empty: every game. Examples: latest 00:00 (European evening), earliest 18:00 and latest 23:00 (weekend and Christmas games).",
        "fr": "Seuls les matchs qui commencent entre ces deux heures (HH:MM, incluses) sont ajoutés. Heure au plus tôt vide : « à partir de 06:00 » ; au plus tard vide : « jusqu'à 05:59 ». Les deux vides : tous les matchs. Exemples : au plus tard 00:00 (soirée européenne), au plus tôt 18:00 et au plus tard 23:00 (matchs du week-end et de Noël)."
      }
    },
    {
      "key": "earliest_time",
      "type": "string",
      "label": {
        "en": "Earliest tip-off",
        "fr": "Début au plus tôt"
      },
      "description": {
        "en": "Optional, HH:MM. Empty: 06:00.",
        "fr": "Facultatif, HH:MM. Vide : 06:00."
      },
      "placeholder": {
        "en": "e.g. 18:00",
        "fr": "ex. 18:00"
      }
    },
    {
      "key": "latest_time",
      "type": "string",
      "label": {
        "en": "Latest tip-off",
        "fr": "Début au plus tard"
      },
      "description": {
        "en": "HH:MM, included. 00:00 keeps the games starting at midnight at the latest. Empty: 05:59.",
        "fr": "HH:MM, incluse. 00:00 garde les matchs qui commencent au plus tard à minuit. Vide : 05:59."
      },
      "placeholder": {
        "en": "e.g. 00:00",
        "fr": "ex. 00:00"
      },
      "default": "00:00"
    },
    {
      "key": "days_ahead",
      "type": "number",
      "label": {
        "en": "Days ahead",
        "fr": "Jours à l'avance"
      },
      "description": {
        "en": "How many days of upcoming games the calendar holds (1 to 60).",
        "fr": "Nombre de jours de matchs à venir dans le calendrier (1 à 60)."
      },
      "placeholder": {
        "en": "21",
        "fr": "21"
      },
      "default": 21,
      "min": 1,
      "max": 60
    },
    {
      "key": "show_scores",
      "type": "boolean",
      "label": {
        "en": "Show the final scores",
        "fr": "Afficher les scores finaux"
      },
      "description": {
        "en": "Write the score in the games already played. Off by default: no spoiler if you watch the replay the next morning.",
        "fr": "Écrit le score dans les matchs déjà joués. Désactivé par défaut : pas de spoiler si vous regardez le replay le lendemain."
      },
      "default": false
    }
  ],
  "actions": [
    {
      "key": "sync_now",
      "label": {
        "en": "Synchronize now",
        "fr": "Synchroniser maintenant"
      },
      "description": {
        "en": "Read the NBA schedule now and update the calendar of every user who enabled the integration.",
        "fr": "Lit le calendrier NBA maintenant et met à jour le calendrier de chaque utilisateur ayant activé l'intégration."
      },
      "timeout_seconds": 60
    }
  ]
}
